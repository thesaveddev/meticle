# === Server ===
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# === Database ===
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meticle
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_QUERY_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000

# === JWT ===
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# === Redis (optional — falls back to in-memory) ===
REDIS_URL=redis://localhost:6379

# === SMTP / Email (optional — falls back to console output) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@meticlecare.com

# === Stripe / Billing (optional — auto-provisions products on first use) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=

# === HTTPS / TLS (optional — disabled unless HTTPS=true) ===
HTTPS=false
HTTPS_CERT_PATH=certs/cert.pem
HTTPS_KEY_PATH=certs/key.pem

# === Feature Flags ===
FEATURE_SEED_INVOICES=false

# === Logging ===
LOG_LEVEL=debug
