# === Server ===
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# === Database ===
DATABASE_URL=postgres://meticle_app:change_me@localhost:5432/meticle
DATABASE_MIGRATE_URL=postgres://postgres:change_me@localhost:5432/meticle
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_QUERY_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000

# === JWT ===
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# === Redis (optional — falls back to in-memory) ===
REDIS_URL=redis://localhost:6379

# === SMTP / Email (optional — falls back to console output) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@meticlecare.com

# === Stripe / Billing (optional — auto-provisions products on first use) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=

# === HTTPS / TLS (optional — disabled unless HTTPS=true) ===
HTTPS=false
HTTPS_CERT_PATH=certs/cert.pem
HTTPS_KEY_PATH=certs/key.pem

# === Logging ===
LOG_LEVEL=debug

# === Rate limits (optional — omit to use the built-in defaults) ===
# Every value here is a per-IP request cap. A bad value falls back to the
# default, and anything above ten times the default is clamped, so a typo
# cannot switch a protection off. See shared/middleware/rateLimits.ts.
#
# These exist so staging can exercise the real thresholds. Leave them unset in
# production: the defaults are the values tuned against a real care home
# onboarding, and there is no reason to run production on anything else.
#
# RATE_LIMIT_REGISTER=30          # per 15 min; seats a full care home at once
# RATE_LIMIT_EMAIL_CODE=10        # per min; bounds spray across many addresses
# RATE_LIMIT_FORGOT_PASSWORD=20   # per hour; a reset only reaches known accounts
#
# Login is deliberately NOT configurable. Password guessing is bounded per
# account by LOGIN_MAX_ATTEMPTS as well, and neither should be a variable.
