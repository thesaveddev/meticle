# Build stage
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
COPY packages/shared/package*.json ./packages/shared/
RUN npm install
COPY . .
RUN npm run build --workspace=@meticle/shared
RUN npm run build --workspace=@meticle/api

# Production stage
FROM node:20-alpine
# Chromium is required by puppeteer-core for PDF generation (invoices,
# evidence packs, compliance reports). puppeteer-core does NOT bundle a
# browser, so without this every PDF download 500s in production.
RUN apk add --no-cache tini chromium nss freetype harfbuzz ca-certificates ttf-freefont font-noto-emoji \
  && rm -rf /var/cache/apk/*
ENV CHROME_PATH=/usr/bin/chromium
WORKDIR /app
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/apps/api/package*.json ./apps/api/
COPY --from=builder /app/apps/api/dist/apps/api/src ./apps/api/dist
COPY --from=builder /app/apps/api/src/shared/database/*.sql ./apps/api/dist/shared/database/
COPY --from=builder /app/apps/api/src/shared/database/migrations ./apps/api/dist/shared/database/migrations
COPY --from=builder /app/apps/api/scripts ./apps/api/scripts
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules

EXPOSE 3002
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/api/dist/index.js"]
