PORT=3005
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=hello@meticlecare.com
TRACKING_BASE_URL=http://localhost:3005
COMPANIES_HOUSE_API_KEY=  # optional — get free from developer.company-information.service.gov.uk
HUNTER_API_KEY=            # optional — get from hunter.io

# Signs the unsubscribe link every outbound message carries. Without it (or
# JWT_SECRET) the link is sent unsigned and accepted unsigned, and that is logged on
# the first send — a marketing email with no way out is a compliance defect, so this
# belongs in any deployment that sends a campaign.
MARKETING_UNSUBSCRIBE_SECRET=

# The public origin this tool is reachable at, used to build unsubscribe links. Left
# unset it falls back to TRACKING_BASE_URL, then to http://localhost:PORT.
PUBLIC_BASE_URL=
