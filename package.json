{
  "name": "meticle",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "test": "npm test --workspaces",
    "test:api": "npm test -w apps/api",
    "test:web": "npm test -w apps/web",
    "brand:build": "node brand/build-from-supplied.mjs",
    "brand:test": "node --test brand/*.test.mjs",
    "brand:check": "node brand/check-play-assets.mjs",
    "brand:review": "node brand/verify-mobile-assets.mjs",
    "brand:install": "node brand/install-assets.mjs",
    "design:sync": "node scripts/design/sync.mjs",
    "design:check": "node scripts/design/sync.mjs --check",
    "design:lint": "node scripts/design/lint.mjs",
    "design:lint:update": "node scripts/design/lint.mjs --update",
    "design:test": "node --test scripts/design/design.test.mjs",
    "visual:test": "playwright test",
    "visual:update": "playwright test --update-snapshots",
    "store:validate": "node store/validate.mjs",
    "store:publish": "node store/publish.mjs",
    "store:data-safety": "node store/data-safety/make-fixture.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/nodemailer": "^8.0.1",
    "concurrently": "^10.0.3",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "nodemailer": "^9.0.3",
    "xlsx": "^0.18.5"
  }
}
