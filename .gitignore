node_modules/
dist/
build/
dev-dist/
.env
.env.local
*.log
.DS_Store
coverage/
.nyc_output/
uploads/
tmp/

# Generated artefacts that must never be committed
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/
packages/shared/src/*.js
packages/shared/src/*.js.map

# Local tooling, scratch output and private collateral
.agents/
.freebuff/
brag-output-*/
outreach/
Store assets/

# Local databases. The marketing CRM (leads, contact details, email logs) is
# personal data by design; a committed SQLite file is a breach waiting for its
# first INSERT. Data files are created at runtime and stay on the machine that
# created them (T0-17).
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Generated store output. `Store assets/` above is a different directory and
# never matched the path the capture script and runbook actually use, so the
# screenshots and any built APK were not being ignored and could be committed by
# accident. Both spellings are listed deliberately.
store-assets/
*.apk
*.aab

# Google Play / EAS service account keys. These are bearer credentials for the
# Play publishing API: committing one hands anyone who clones the repo the
# ability to upload releases to the store. They belong in a password manager or
# an env var, never in the working tree.
*service*account*.json
*play*key*.json
google-services*.json
meticlecare-*.json
*.p12
*.keystore
*.jks

# Play Data safety CSV exports. `template.csv` is downloaded from the developer
# account and `generated.csv` is derived from it; neither is source, and the
# export contains the full declaration.
store/data-safety/template.csv
store/data-safety/generated.csv

# Visual regression scratch output. The baselines under
# tests/visual/__screenshots__ are deliberately NOT ignored — they are the
# reviewed record of what the design system is supposed to look like, and a
# harness whose baselines are untracked cannot gate anything.
playwright-report/
tests/visual/__results__/
test-results/

# Session/media upload scrap that is not application source. The pipeline's
# server-change classifier diffs apps/api, apps/web, packages, deploy.sh and
# docker-compose files, so dropping these here keeps them out of release
# classification and out of the repo.videos/
section-*.png

# Root-level scratch: ad-hoc typecheck/build logs and Playwright section
# screenshots. Both git status noise and, worse, easy to `git add -A` by
# mistake when they sit at the repo root.
/tmp_*.log
/tmp_*.png

# Git must speak HTTP/1.1 to GitHub from this machine (Opeyemi's laptop).
# Pushing master over the default HTTP/2 repeatedly failed with
# "remote: Internal Server Error / ! [remote rejected] master -> master",
# three times on 2026-10-07, while GitHub's status page showed Git Operations
# healthy. `git -c http.version=HTTP/1.1 push` succeeded immediately, so the
# failure is specific to this client's HTTP/2 (chunked upload) path against
# GitHub's git-receive-pack. Config is set in BOTH ~/.gitconfig (global) and
# .git/config (local) so every push, pull, clone and CI-helper on this
# checkout uses HTTP/1.1 regardless of which config file a tool reads.
# Remove these two lines only after GitHub-side HTTP/2 pushes work again.
# Config (not gitignore) is the live setting; these comments are the record.
#   git config --global http.version HTTP/1.1 && git config http.version HTTP/1.1

# The incident queue is real app source with committed tests that import it;
# ignoring it left the tree uncheckable (every fresh clone failed typecheck).
# Mobile ships through EAS, but it lives in this repo and must stay green in CI.

# Mica action framework source. Part of the reusable voice-action layer; shipped
# as first-class app modules rather than scratch.
# (No ignore here: ai.actions.ts, ai.gateway.ts, actions/ and the new migrations
# are intentional release content.)
