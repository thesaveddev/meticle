node_modules/
dist/
build/
dev-dist/
.env
.env.local
*.log
.DS_Store
coverage/
.nyc_output/
uploads/
tmp/

# Generated artefacts that must never be committed
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/
packages/shared/src/*.js
packages/shared/src/*.js.map

# Local tooling, scratch output and private collateral
.agents/
.freebuff/
brag-output-*/
outreach/
Store assets/

# Local databases. The marketing CRM (leads, contact details, email logs) is
# personal data by design; a committed SQLite file is a breach waiting for its
# first INSERT. Data files are created at runtime and stay on the machine that
# created them (T0-17).
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Generated store output. `Store assets/` above is a different directory and
# never matched the path the capture script and runbook actually use, so the
# screenshots and any built APK were not being ignored and could be committed by
# accident. Both spellings are listed deliberately.
store-assets/
*.apk
*.aab
