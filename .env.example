# Meticle Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────
POSTGRES_DB=meticle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
APP_ROLE_PASSWORD=changeme

# ── Redis ─────────────────────────────────────────────
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=changeme-min-32-chars
JWT_REFRESH_SECRET=changeme-min-32-chars

# ── SMTP (Email) ──────────────────────────────────────
SMTP_HOST=safari.mxrouting.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@meticlecare.com
SMTP_PASS=changeme
SMTP_FROM=notifications@meticlecare.com
SMTP_FROM_NOTIFICATIONS=notifications@meticlecare.com
SMTP_FROM_BILLING=billing@meticlecare.com
SMTP_FROM_SECURITY=security@meticlecare.com
SMTP_FROM_SUPPORT=support@meticlecare.com
SMTP_FROM_TEAM=hello@meticlecare.com

# ── Stripe ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
STRIPE_PRICE_STARTER=price_changeme
STRIPE_PRICE_PROFESSIONAL=price_changeme

# ── App ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=https://meticlecare.com,https://www.meticlecare.com
VITE_PUBLIC_SITE_URL=https://meticlecare.com
